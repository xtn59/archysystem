focused_border_colour    : #000000
unfocused_border_colour  : #000000
swap_border_colour       : #eeeeee

gaps                    : 3
border_width            : 1
master_width            : 65 # Percentage of screen width
resize_master_amount    : 1
resize_stack_amount     : 20
move_window_amount      : 50
resize_window_amount    : 50
snap_distance           : 2
motion_throttle         : 60 # Set to screen refresh rate for smoothest motions
new_win_focus           : true
should_float            : "xterm"
warp_cursor             : true
floating_on_top         : true
info                    : true
new_win_master          : false
can_swallow             : "xterm"
can_be_swallowed        : "mpv", "sxiv"
start_fullscreen        : "mpv", "vlc"
exec                    : "xwallpaper --stretch /root/.archysystem/wallpapers/sea.png"

mod_key : super
bind : mod + space :         "xterm"
bind : mod + q :             "xrun"
bind : mod + w :             "rofi -show window"
bind : mod + alt + w :       "/root/.archysystem/scripts/menu.sh"
bind : mod + alt + q :       "/root/.archysystem/scripts/wallpapers.sh"
call : XF86MonBrightnessDown : brightness_down
call : XF86MonBrightnessUp   : brightness_up
call : XF86AudioLowerVolume  : volume_down
call : XF86AudioRaiseVolume  : volume_up
call : mod + c :              close_window
call : mod + alt + z :        centre_window
call : mod + alt + x :        pull_window
call : mod + n :              quit
call : mod + Right :          focus_next
call : mod + Down :           focus_next
call : mod + Left :           focus_prev
call : mod + Up :             focus_prev
call : mod + shift + Right :  master_next
call : mod + shift + Left :   master_prev
call : mod + semicolon :      master_increase
call : mod + l :              master_decrease
call : mod + period :         stack_increase
call : mod + comma :          stack_decrease
call : mod + alt + Up :       move_win_up
call : mod + alt + Down :     move_win_down
call : mod + alt + Left :     move_win_left
call : mod + alt + Right :    move_win_right
call : alt + shift + Up :     resize_win_up
call : alt + shift + Down :   resize_win_down
call : alt + shift + Left :   resize_win_left
call : alt + shift + Right :  resize_win_right
call : mod + equal :          increase_gaps
call : mod + minus :          decrease_gaps
call : mod + alt + equal :    increase_border_width
call : mod + alt + minus :    decrease_border_width
call : mod + p :              toggle_floating
call : mod + shift + p :      global_floating
call : mod + f :              fullscreen
call : mod + m :              reload_config

workspace : mod + 1          : move 1
workspace : mod + shift + 1  : swap 1
workspace : mod + 2          : move 2
workspace : mod + shift + 2  : swap 2
workspace : mod + 3          : move 3
workspace : mod + shift + 3  : swap 3
workspace : mod + 4          : move 4
workspace : mod + shift + 4  : swap 4
workspace : mod + 5          : move 5
workspace : mod + shift + 5  : swap 5
workspace : mod + 6          : move 6
workspace : mod + shift + 6  : swap 6
workspace : mod + 7          : move 7
workspace : mod + shift + 7  : swap 7
workspace : mod + 8          : move 8
workspace : mod + shift + 8  : swap 8
workspace : mod + 9          : move 9
workspace : mod + shift + 9  : swap 9
